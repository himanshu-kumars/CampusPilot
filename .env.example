# CampusPilot environment variables
# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase (public, safe for browser)
# Use whichever key your project dashboard shows — anon (legacy) or publishable (new).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# AI provider key (SERVER-ONLY — never prefix with NEXT_PUBLIC_)
# The study planner accepts either variable; provider-specific wins.
GOOGLE_GENERATIVE_AI_API_KEY=
AI_API_KEY=

# Push reminders / cron (Phase 5, optional — app works without these)
# Generate a pair: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Random secret for /api/cron/reminders (Vercel sends it automatically for crons)
CRON_SECRET=
# Supabase service-role key (SERVER-ONLY) — lets the cron read due items.
# Find it in Supabase → Project Settings → API. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
